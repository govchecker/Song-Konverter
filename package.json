{
  "name": "song-konverter",
  "private": true,
  "version": "1.0.0",
  "description": "Song Konverter: Ultimate Guitar zu ChordPro (MobileSheets) als Desktop-App",
  "author": "Martin",
  "type": "module",
  "main": "electron/main.cjs",
  "desktopName": "song-konverter.desktop",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist release",
    "electron:dev": "ELECTRON_DEV=1 electron .",
    "electron:start": "vite build && electron .",
    "dist:linux": "vite build && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "de.martin.songkonverter",
    "productName": "Song Konverter",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "Song-Konverter-${version}.${ext}",
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "syncDesktopName": true,
      "icon": "build/icon.png"
    }
  }
}
